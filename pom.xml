<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>net.chumbucket</groupId>
    <artifactId>sorekillrtp</artifactId>
    <version>1.2.0</version>
    <name>SorekillRTP</name>
    <description>Cross-server random teleport using Velocity + Redis works by itself too.</description>

    <properties>
        <java.version>21</java.version>
        <!--
            Compile against the oldest supported Spigot API. Paper implements
            this API, keeping one JAR loadable on both platforms across 1.21.x,
            26.1.2, and 26.2.
        -->
        <platform.api.group>org.spigotmc</platform.api.group>
        <platform.api.artifact>spigot-api</platform.api.artifact>
        <platform.api.version>1.21-R0.1-SNAPSHOT</platform.api.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc-snapshots</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot API (provided by the server at runtime) -->
        <dependency>
            <groupId>${platform.api.group}</groupId>
            <artifactId>${platform.api.artifact}</artifactId>
            <version>${platform.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Redis client (Jedis; smaller than Lettuce/Netty) -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>5.1.5</version>
        </dependency>

        <!-- JSON serialization for Redis payloads -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- Optional but recommended: annotations -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>26.0.1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>

        <plugins>
            <!-- Compile settings -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- Shade dependencies into the jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>

                            <!-- Keep your jar clean -->
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>

                            <!-- Prevent classpath conflicts -->
                            <relocations>
                                <!-- Jedis -->
                                <relocation>
                                    <pattern>redis.clients.jedis</pattern>
                                    <shadedPattern>net.chumbucket.sorekillrtp.libs.jedis</shadedPattern>
                                </relocation>

                                <!-- Jedis uses commons-pool2 -->
                                <relocation>
                                    <pattern>org.apache.commons.pool2</pattern>
                                    <shadedPattern>net.chumbucket.sorekillrtp.libs.pool2</shadedPattern>
                                </relocation>

                                <!-- Gson -->
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>net.chumbucket.sorekillrtp.libs.gson</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        Optional source-compatibility checks for the post-1.21 Spigot API. Run
        these profiles with JDK 25, for example:

          mvn -Pspigot-26.2 clean verify

        The profiles intentionally do not change plugin.yml's api-version; the
        produced plugin remains loadable on every supported 1.21.x server.
    -->
    <profiles>
        <profile>
            <id>spigot-26.1.2</id>
            <properties>
                <platform.api.version>26.1.2-R0.1-SNAPSHOT</platform.api.version>
            </properties>
        </profile>
        <profile>
            <id>spigot-26.2</id>
            <properties>
                <platform.api.version>26.2-R0.1-SNAPSHOT</platform.api.version>
            </properties>
        </profile>
        <profile>
            <id>paper-1.21</id>
            <properties>
                <platform.api.group>io.papermc.paper</platform.api.group>
                <platform.api.artifact>paper-api</platform.api.artifact>
                <platform.api.version>1.21-R0.1-SNAPSHOT</platform.api.version>
            </properties>
        </profile>
        <profile>
            <id>paper-26.1.2</id>
            <properties>
                <platform.api.group>io.papermc.paper</platform.api.group>
                <platform.api.artifact>paper-api</platform.api.artifact>
                <platform.api.version>26.1.2.build.74-stable</platform.api.version>
            </properties>
        </profile>
        <profile>
            <id>paper-26.2</id>
            <properties>
                <platform.api.group>io.papermc.paper</platform.api.group>
                <platform.api.artifact>paper-api</platform.api.artifact>
                <platform.api.version>26.2.build.60-beta</platform.api.version>
            </properties>
        </profile>
    </profiles>
</project>
